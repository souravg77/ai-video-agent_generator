# One file per channel/brand: copy to brands/<name>.env, fill in, then run
#   BRAND=<name> npm run db:migrate
#   BRAND=<name> npm run auth:youtube      (sign in with this brand's channel)
#   BRAND=<name> npm run auth:meta         (this brand's Page and Instagram)
#   npm run agents                          (runs every brand in brands/)
# Anything not set here comes from the shared .env (API keys, DATABASE_URL, R2).
# Files in brands/ other than example.env are ignored by git, since they hold tokens.

AGENT_NICHE=
AGENT_POST_TIMES_UTC=15:00
AGENT_PLATFORMS=youtube,facebook,instagram

# Each brand needs its own review page port (npm run agents picks 3001, 3002… if unset)
# REVIEW_PORT=3001

# Language and format for this brand's videos
VIDEO_LANGUAGE=English
VIDEO_FORMAT=short
# ELEVENLABS_VOICE_ID=

# This brand's accounts (written by the auth scripts)
YOUTUBE_REFRESH_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# Tables live in a Postgres schema named after the brand; override if you like
# DB_SCHEMA=
