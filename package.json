{
  "name": "ai-video-agent",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Agent that generates short vertical videos and posts them to YouTube, Facebook and Instagram.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsx scripts/check-setup.ts",
    "auth:youtube": "tsx scripts/youtube-auth.ts",
    "auth:meta": "tsx scripts/meta-token.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "make": "tsx scripts/make-video.ts",
    "test": "tsx --test test/*.test.ts",
    "post:youtube": "tsx scripts/post-youtube.ts",
    "post": "tsx scripts/post.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@aws-sdk/client-s3": "3.1149.0",
    "dotenv": "16.4.5",
    "googleapis": "183.0.0",
    "pg": "8.13.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
