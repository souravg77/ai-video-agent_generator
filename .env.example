# Copy to .env and fill in. Never commit .env.

# --- Agent brain (Claude API) ---
ANTHROPIC_API_KEY=

# --- Database (Postgres: Supabase or Neon connection string) ---
DATABASE_URL=postgres://user:pass@host:5432/video_agent

# --- Object storage (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=video-agent
# Public base URL for the bucket (r2.dev subdomain or custom domain). Instagram fetches videos from here.
R2_PUBLIC_BASE_URL=

# --- YouTube (Google Cloud OAuth client, type "Desktop app") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled by `npm run auth:youtube`
YOUTUBE_REFRESH_TOKEN=

# --- Meta (Facebook Page + Instagram) ---
META_APP_ID=
META_APP_SECRET=
# Short-lived user token from Graph API Explorer; `npm run auth:meta` exchanges it
META_SHORT_LIVED_USER_TOKEN=
# Filled by `npm run auth:meta`
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v21.0
