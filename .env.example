# Copy to .env and fill in. Never commit .env.

# --- Agent brain (Claude API) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Voice-over (ElevenLabs text to speech) ---
ELEVENLABS_API_KEY=
# Default is the "Rachel" voice; pick another in the ElevenLabs voice library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Your plan's price per 1,000 characters, for cost tracking
ELEVENLABS_USD_PER_1K_CHARS=0.3

# --- Stock footage (free key from pexels.com/api) ---
PEXELS_API_KEY=

# --- FFmpeg (must be installed; override if not on PATH) ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Database (Postgres: Supabase or Neon connection string) ---
DATABASE_URL=postgres://user:pass@host:5432/video_agent

# --- Object storage (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=video-agent
# Public base URL for the bucket (r2.dev subdomain or custom domain). Instagram fetches videos from here.
R2_PUBLIC_BASE_URL=

# --- YouTube (Google Cloud OAuth client, type "Desktop app") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled by `npm run auth:youtube`
YOUTUBE_REFRESH_TOKEN=

# --- Meta (Facebook Page + Instagram) ---
META_APP_ID=
META_APP_SECRET=
# Short-lived user token from Graph API Explorer; `npm run auth:meta` exchanges it
META_SHORT_LIVED_USER_TOKEN=
# Filled by `npm run auth:meta`
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v21.0

# --- Agent (npm run agent) ---
# What the channel is about; Claude plans ideas from this. Leave empty to only use ideas you add yourself.
AGENT_NICHE=
# Posting times each day, in UTC, comma separated
AGENT_POST_TIMES_UTC=15:00
AGENT_PLATFORMS=youtube,facebook,instagram
# How many days ahead to keep planned
AGENT_PLAN_DAYS=7
# Make each video this many hours before its slot, to leave time for review
AGENT_RENDER_LEAD_HOURS=36
# true = post without waiting for approval
AGENT_AUTO_APPROVE=false
AGENT_TICK_SECONDS=60
REVIEW_PORT=3000
# Set to open the review page to your network (sign in with any username and this password)
REVIEW_PASSWORD=
# Phase 6 (docs/scaling.md). Language the videos are written and spoken in, e.g. Spanish
VIDEO_LANGUAGE=English
# short = vertical Shorts/Reels; long = 4-8 minute 16:9 YouTube videos (YouTube only)
VIDEO_FORMAT=short
# A font that covers your language, e.g. "Noto Sans CJK JP" for Japanese
CAPTION_FONT=DejaVu Sans
# true = fetch new comments and draft replies for you to approve on the review page
AGENT_COMMENT_REPLIES=false
# --- Running it for real (docs/hosting.md) ---
# Stop making videos once this month's spend reaches this many USD (empty = no cap)
AGENT_MONTHLY_BUDGET_USD=
# AGENT_AUTO_APPROVE only takes effect after this many approved posts
AGENT_AUTO_APPROVE_AFTER=30
# Delete local files of posted/rejected videos after this many days (0 = keep)
AGENT_KEEP_RENDERS_DAYS=14
# Post some platforms later than the slot, in minutes, e.g. facebook=60,instagram=120
AGENT_PLATFORM_DELAYS=
# Rotate hook styles and favour the ones that get more views
AGENT_HOOK_TESTS=true
# Approve from your phone: token from @BotFather, then npm run telegram:setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public /privacy and /data-deletion pages for the Google and Meta reviews
PRIVACY_OWNER_NAME=
PRIVACY_CONTACT_EMAIL=
# docker compose: the review page's public name, for HTTPS
DOMAIN=
# Generated opening clip via fal.ai (off | hook)
GENERATED_CLIPS=off
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/text-to-video
GENERATED_CLIP_SECONDS=5
GENERATED_CLIP_USD_PER_SECOND=0.1
# Slack or Discord incoming webhook for failure alerts and the weekly report
ALERT_WEBHOOK_URL=
# How often to save views/likes/watch time for recent posts
AGENT_STATS_HOURS=6
# Day the weekly report goes out, after 09:00 UTC (0 = Sunday, 1 = Monday … 6 = Saturday)
AGENT_REPORT_WEEKDAY=1
